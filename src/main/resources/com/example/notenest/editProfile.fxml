<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<GridPane alignment="center" hgap="10" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #1E1F22" styleClass="edit-profile-pane" stylesheets="@editProfile.css" vgap="12" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.notenest.MainController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40" />
    </padding>

    <!-- Profile Editing Form -->
    <VBox spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="0">
        <Label styleClass="form-label" text="Department:" textFill="WHITE" />
        <TextField fx:id="departmentField" promptText="Enter your department" styleClass="input-field" />

        <Label styleClass="form-label" text="Trimester:" />
        <TextField fx:id="trimesterField" promptText="Enter your trimester" styleClass="input-field" />

        <Label styleClass="form-label" text="ID:" />
        <TextField fx:id="idField" promptText="Enter your ID" styleClass="input-field" />

        <Label styleClass="form-label" text="Bio:" />
        <TextField fx:id="bioField" promptText="Enter your bio" styleClass="input-field" />

        <!-- Button Container -->
        <HBox spacing="10">
            <Button prefHeight="42.0" prefWidth="141.0" styleClass="save-button" text="Save Changes" />
            <Button onAction="#switchToHomePage" prefHeight="42.0" prefWidth="141.0" styleClass="home-button" text="Home" />
        </HBox>
    </VBox>

    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" minWidth="50" prefWidth="100" /> <!-- Column for Labels and TextFields -->
    </columnConstraints>
    <rowConstraints>
        <RowConstraints vgrow="ALWAYS" /> <!-- Allows vertical growth if needed -->
    </rowConstraints>
</GridPane>
